# flair project file
Version: 300
Mode: fluka
Title: LiF neutron source
md5: d268660e6c4d37254e13a4ef93976855
Input:
* Set the defaults for precision simulations
DEFAULTS PRECISIO
#define ENERGY -0.0025
* Define the beam characteristics
!BEAM NEUTRON $ENERGY 0 -3000.0 -1.0 -1.0 1.0
	@select=8
* Define the beam characteristics
!BEAM NEUTRON -0.00035 '=dT2dp(0.0007,0.0007,Mn)' 13140.0 2.0 0 -1.0
	@select=8
*Neutron beam
!BEAM NEUTRON -0.0005 0 13140.0 2.0 0 -1.0
	@select=8
!BEAMPOS , 0 0 -0.1 0 0
*Neutron beam for debug
!BEAM NEUTRON -1E-06 0 0 -1.0 -1.0 1.0
	@select=8
!BEAMPOS , 0 0 33 0 0
*Proton beam
BEAM PROTON $ENERGY 0 0 -1.0 -1.0 1.0
	@select=8
BEAMPOS , 0 0 -0.9 0 0
LOW-PWXS ENDF-VIII0
LAM-BIAS GDECAY,, 0.0001 LiF PROTON
LAM-BIAS INEALL,, 0.0001 BORON NEUTRON
PHYSICS COALESCE 1
PHYSICS EVAPORAT 3
USRBIN neutrons 10 NEUTRON -21 20 20 35 -20 -20 -25 100 100 100
USRBIN photons 10 PHOTON -21 20 20 35 -20 -20 -25 100 100 100
USRBIN protons 10 PROTON -21 20 20 35 -20 -20 -25 100 100 100
USRBIN n_RZ 11 NEUTRON -23 20,, 35,,, -30 500 1 500
USRBIN g_RZ 11 PHOTON -23 20,, 35,,, -30 500 1 500
USRBDX n1way 101 NEUTRON -40 LIF FLANGE,, 0.001 1E-13 100,,, 10
USRBDX n2way 111 NEUTRON -40 LIF FLANGE,, 0.001 1E-13 100,,, 10
USRBDX n1wayOut 101 NEUTRON -40 MOD33 AIR,, 0.001 1E-13 100,,, 10
USRBDX n2wayOut 111 NEUTRON -40 MOD33 AIR,, 0.001 1E-13 100,,, 10
USRBDX toflan1 99 NEUTRON -41 LIF FLANGE,, 0.001 1E-13 500,,, 10
USRBDX toflan2 109 NEUTRON -41 LIF FLANGE,, 0.001 1E-13 500,,, 10
USRBDX 0cm 99 NEUTRON -41 FLANGE MOD2,, 0.001 1E-13 500,,, 1
USRBDX 0cm 109 NEUTRON -41 FLANGE MOD2,, 0.001 1E-13 500,,, 1
USRBDX 4cm 99 NEUTRON -41 MOD4 MOD5,, 0.001 1E-13 500,,, 1
USRBDX 4cm 109 NEUTRON -41 MOD4 MOD5,, 0.001 1E-13 500,,, 1
USRBDX 8cm 99 NEUTRON -41 MOD8 MOD9,, 0.001 1E-13 500,,, 1
USRBDX 8cm 109 NEUTRON -41 MOD8 MOD9,, 0.001 1E-13 500,,, 1
USRBDX 12cm 99 NEUTRON -41 MOD12 MOD13,, 0.001 1E-13 500,,, 1
USRBDX 12cm 109 NEUTRON -41 MOD12 MOD13,, 0.001 1E-13 500,,, 1
USRBDX 16cm 99 NEUTRON -41 MOD16 MOD17,, 0.001 1E-13 500,,, 1
USRBDX 16cm 109 NEUTRON -41 MOD16 MOD17,, 0.001 1E-13 500,,, 1
USRBDX 20cm 99 NEUTRON -41 MOD20 MOD21,, 0.001 1E-13 500,,, 1
USRBDX 20cm 109 NEUTRON -41 MOD20 MOD21,, 0.001 1E-13 500,,, 1
USRBDX 24cm 99 NEUTRON -41 MOD24 MOD25,, 0.001 1E-13 500,,, 1
USRBDX 24cm 109 NEUTRON -41 MOD24 MOD25,, 0.001 1E-13 500,,, 1
USRBDX 28cm 99 NEUTRON -41 MOD28 MOD29,, 0.001 1E-13 500,,, 1
USRBDX 28cm 109 NEUTRON -41 MOD28 MOD29,, 0.001 1E-13 500,,, 1
USRBDX 32cm 99 NEUTRON -41 MOD32 MOD33,, 0.001 1E-13 500,,, 1
USRBDX 32cm 109 NEUTRON -41 MOD32 MOD33,, 0.001 1E-13 500,,, 1
USRBDX toair_1 99 NEUTRON -41 MOD33 AIR,, 0.001 1E-13 500,,, 1
USRBDX toair_2 109 NEUTRON -41 MOD33 AIR,, 0.0025 1E-13 500,,, 1
USRBDX tube1 99 NEUTRON -42 TUBE AIR,, 0.001 1E-13 500,,, 1
USRBDX tube2 109 NEUTRON -42 TUBE AIR,, 0.001 1E-13 500,,, 1
USRBDX pg1lin 101 PHOTON -43 BORON PHANTOM,, 0.0025 1E-6 500,,, 1
USRBDX pg2lin 111 PHOTON -43 BORON PHANTOM,, 0.0025 1E-6 500,,, 1
USRBDX detg1lin 101 PHOTON -44 AIR LINECAM,, 0.0025 1E-6 500,,, 1
USRBDX detg2lin 111 PHOTON -44 AIR LINECAM,, 0.0025 1E-6 500,,, 1
GEOBEGIN COMBNAME
SPH blkbody,, 0.0 0.0 100000.0
	@select=8
SPH air,, 0.0 0.0 10000.0
	@select=8
RCC pipeIn 0 0 -30 0 0 30.1 3.5
RCC pipeOut 0 0 -30 0 0 30.1 4
RCC lif 0 0 -0.9 0 0 1 1.9
RCC flange 0 0 -0.5 0 0 1.0 4
RPP tube -15.0 15.0 -15.0 15.0 -20 0
RPP tube1 -10.0 10.0 -10.0 10.0 0 32.0
RPP tubeHole -9.0 9.0 -9.0 9.0 -16 0
RPP tubeHol1 -9.0 9.0 -9.0 9.0 -20 -15
RPP phantom -3 3 -3 3 35 41
RPP boron -1 1 -1 1 37 39
RPP linecam -10 10 9.9 10.1 37.8 38
XYP modp2 1
XYP modp3 2
XYP modp4 3
XYP modp5 4
XYP modp6 5
XYP modp7 6
