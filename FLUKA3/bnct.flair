# flair project file
Version: 300
Mode: fluka
Title: LiF neutron source
md5: 769248968ef37218bff5fefeca5c8948
Input:
* Set the defaults for precision simulations
DEFAULTS PRECISIO
#define ENERGY -0.0025
* Define the beam characteristics
!BEAM NEUTRON $ENERGY 0 -3000.0 -1.0 -1.0 1.0
	@select=8
* Define the beam characteristics
!BEAM NEUTRON -0.00035 '=dT2dp(0.0007,0.0007,Mn)' 13140.0 2.0 0 -1.0
	@select=8
*Neutron beam
!BEAM NEUTRON -0.0005 0 13140.0 2.0 0 -1.0
	@select=8
!BEAMPOS , 0 0 -0.1 0 0
*Proton beam
BEAM PROTON $ENERGY 0 0 -1.0 -1.0 1.0
	@select=8
BEAMPOS , 0 0 -0.9 0 0
LOW-PWXS ENDF-VIII0
LAM-BIAS GDECAY 1 0.0001 LiF PROTON
USRBIN neutrons 10 NEUTRON -21 20 20 35 -20 -20 -25 100 100 100
USRBIN photons 10 PHOTON -21 20 20 35 -20 -20 -25 100 100 100
USRBIN protons 10 PROTON -21 20 20 35 -20 -20 -25 100 100 100
USRBIN n_out 10 NEUTRON -22 15 15 32 -15 -15 31 100 100 1
USRBIN n_RZ 11 NEUTRON -23 30,, 35,,, -30 1000 1 1000
USRBIN g_RZ 11 PHOTON -23 30,, 35,,, -30 1000 1 1000
USRBDX n1way 101 NEUTRON -40 LIF FLANGE,, 0.001 1E-13 100,,, 3
USRBDX n2way 111 NEUTRON -40 LIF FLANGE,, 0.001 1E-13 100,,, 3
USRBDX toflan1 98 NEUTRON -41 LIF FLANGE,, 0.001 1E-13 500,,, 3
USRBDX toflan2 108 NEUTRON -41 LIF FLANGE,, 0.001 1E-13 500,,, 3
USRBDX tomod1_1 98 NEUTRON -41 FLANGE MOD1,, 0.001 1E-13 500,,, 3
USRBDX tomod1_2 108 NEUTRON -41 FLANGE MOD1,, 0.001 1E-13 500,,, 3
USRBDX tomod2_1 98 NEUTRON -41 MOD1 MOD2,, 0.001 1E-13 500,,, 3
USRBDX tomod2_2 108 NEUTRON -41 MOD1 MOD2,, 0.001 1E-13 500,,, 3
USRBDX tomod3_1 98 NEUTRON -41 MOD2 MOD3,, 0.001 1E-13 500,,, 3
USRBDX tomod3_2 108 NEUTRON -41 MOD2 MOD3,, 0.001 1E-13 500,,, 3
USRBDX tomod4_1 98 NEUTRON -41 MOD3 MOD4,, 0.001 1E-13 500,,, 3
USRBDX tomod4_2 108 NEUTRON -41 MOD3 MOD4,, 0.001 1E-13 500,,, 3
USRBDX tomod5_1 98 NEUTRON -41 MOD4 MOD5,, 0.001 1E-13 500,,, 3
USRBDX tomod5_2 108 NEUTRON -41 MOD4 MOD5,, 0.001 1E-13 500,,, 3
USRBDX tomod6_1 98 NEUTRON -41 MOD5 MOD6,, 0.001 1E-13 500,,, 3
USRBDX tomod6_2 108 NEUTRON -41 MOD5 MOD6,, 0.001 1E-13 500,,, 3
USRBDX tomod7_1 98 NEUTRON -41 MOD6 MOD7,, 0.001 1E-13 500,,, 3
USRBDX tomod7_2 108 NEUTRON -41 MOD6 MOD7,, 0.001 1E-13 500,,, 3
USRBDX tomod8_1 98 NEUTRON -41 MOD7 MOD8,, 0.001 1E-13 500,,, 3
USRBDX tomod8_2 108 NEUTRON -41 MOD7 MOD8,, 0.001 1E-13 500,,, 3
USRBDX toair_1 98 NEUTRON -41 MOD8 AIR,, 0.001 1E-13 500,,, 3
USRBDX toair_2 108 NEUTRON -41 MOD8 AIR,, 0.001 1E-13 500,,, 3
USRBDX tube1 101 NEUTRON -42 TUBE AIR,, 0.001 1E-13 500,,, 3
USRBDX tube2 108 NEUTRON -42 TUBE AIR,, 0.001 1E-13 500,,, 3
GEOBEGIN COMBNAME
SPH blkbody,, 0.0 0.0 100000.0
	@select=8
SPH air,, 0.0 0.0 10000.0
	@select=8
RCC pipeIn 0 0 -30 0 0 30.1 3.5
RCC pipeOut 0 0 -30 0 0 30.1 4
RCC lif 0 0 -0.9 0 0 1 1.9
RCC flange 0 0 -0.5 0 0 1.0 5
RPP tube -15.0 15.0 -15.0 15.0 -16 32.0
RPP tube1 -10.0 10.0 -10.0 10.0 -15 32.0
RPP tubeHole -5.0 5.0 -5.0 5.0 -16 0
XYP modEnd1 4
XYP modEnd2 8
XYP modEnd3 12
XYP modEnd4 16
XYP modEnd5 20
XYP modEnd6 24
XYP modEnd7 28
RPP mod -5 5 -5 5 0 32
END
* Black hole
REGION BLKBODY 5
	+blkbody -air
REGION AIR 5
	+air -tube -tubeHole -pipeOut 
REGION LIF 5
	+lif -flange
REGION FLANGE 5
	+flange -mod
REGION TUBE 5
	+tube -tube1 -tubeHole
	alpha=50
REGION TUBE1 5
	+tube1 -mod -tubeHole
	alpha=50
REGION TUBEHOLE 5
	+tubeHole -flange -pipeOut
	alpha=50
REGION PIPEOUT 5
	+pipeOut -pipeIn -flange 
	alpha=50
REGION PIPEIN 5
	+pipeIn -lif -flange
	alpha=50
REGION MOD1 5
	+mod +modEnd1
REGION MOD2 5
	+mod -modEnd1 +modEnd2
REGION MOD3 5
	+mod -modEnd2 +modEnd3
REGION MOD4 5
	+mod -modEnd3 +modEnd4
REGION MOD5 5
	+mod -modEnd4 +modEnd5
REGION MOD6 5
	+mod -modEnd5 +modEnd6
REGION MOD7 5
	+mod -modEnd6 +modEnd7
REGION MOD8 5
	+mod -modEnd7
REGION REG1
	@select=1
END
GEOEND
MATERIAL FLUORINE 9,, 0.0015803
*Polytetrafluoroethylene teflon (C2_F4)n
MATERIAL TEFLON,,, 2.2
COMPOUND TEFLON -0.240183 CARBON -0.759817 FLUORINE
MATERIAL LITHIUM 3,, 0.534
*Lithium fluoride Li_F
MATERIAL LiF,,, 2.635
COMPOUND LiF -0.267585 LITHIUM -0.732415 FLUORINE
MATERIAL CADMIUM 48,, 8.65
MATERIAL TELLURIU 52,, 6.24
*Cadmium telluride Cd_Te
MATERIAL CdTe,,, 6.2
COMPOUND CdTe -0.468355 CADMIUM -0.531645 TELLURIU
MATERIAL CHROMIUM 24,, 7.18
*Stainless-Steel (typical)
*Stainless-Steel is produced with Cr content ranging from
*4 - 19 Atomic Percent, and with C content from 0 - 4 percent.
MATERIAL Stainles,,, 8.0
COMPOUND Stainles 18.0 CHROMIUM 74.0 IRON 8.0 NICKEL
ASSIGNMA , BLCKHOLE BLKBODY
ASSIGNMA , AIR AIR
ASSIGNMA , LEAD TUBE
ASSIGNMA , TEFLON TUBE1
ASSIGNMA , AIR TUBEHOLE
ASSIGNMA , Stainles PIPEOUT
ASSIGNMA , VACUUM PIPEIN
ASSIGNMA , ALUMINUM FLANGE
ASSIGNMA , LiF LIF
ASSIGNMA , TEFLON MOD1 MOD7 2
ASSIGNMA , ALUMINUM MOD2 MOD8 2
ASSIGNMA , VACUUM REG1
* Set the random number seed
RANDOMIZ ,, 377746
* Set the number of primary histories to be simulated in the run
START , 30000000,,, 1
STOP
EndInput

Page: Plot
Calculator:
	|dT2dp(E,dE,m)
	|> Error: name 'E' is not defined
	|E=0.00035
	|dE=0.000035
	|m=Mn
	|> m = 0.93956563
	|dT2dp(E,dE,m)
	|> ans1 = 0.001282637384271
	|dE=0.00035
	|dT2dp(E,dE,m)
	|> ans2 = 0.012826373842713
plotengine: Gnuplot

