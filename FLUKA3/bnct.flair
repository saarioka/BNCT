# flair project file
Version: 300
Mode: fluka
Title: LiF neutron source
md5: 4628e95a5147c9738452707ee366ed30
Input:
RADDECAY , 2 1,, 333333303,, 1
* Set the defaults for precision simulations
DEFAULTS PRECISIO
!#define ENERGY -0.0006
* Define the beam characteristics
!BEAM NEUTRON $ENERGY 0 -3000.0 -1.0 -1.0 1.0
	@select=8
* Define the beam characteristics
!BEAM NEUTRON -0.00035 '=dT2dp(0.0007,0.0007,Mn)' 13140.0 2.0 0 -1.0
	@select=8
*Neutron beam
!BEAM NEUTRON -0.0005 0 13140.0 2.0 0 -1.0
	@select=8
!BEAMPOS , 0 0 -0.1 0 0
*Proton beam
BEAM PROTON -0.0025 0 0 -1.0 -1.0 1.0
	@select=8
BEAMPOS , 0 0 -0.9 0 0
!PHYSICS COALESCE 1
PHYSICS EVAPORAT 3
!EMF
USRBIN Ndepth 10 NEUTRON -22 15 15 35 -15 -15 -20 100 100 100
USRBIN Gdepth 10 PHOTON -22 15 15 35 -15 -15 -20 100 100 100
USRBIN Nwidth 10 NEUTRON -23 15 15 32 -15 -15 31 100 100 1
USRBIN NRZ 11 NEUTRON -24 10,, 10,,, 0 1000 1 1000
!USRBIN NielDep 11 NIEL-DEP -25 5 0 0.3 0 0 0 1000 1000 1000
!USRBIN ScorerNH 10 NEUTRON -26 50 50 20.3 0 0 20.2 100 100 1
!USRBIN ScorerNH2 11 NEUTRON -27 50,, 20.3 0,, 19.3 50 50 1
USRBDX I1_1 98 NEUTRON -34 LIF FLANGE,, 0.0007 1E-13 500,,, 3
USRBDX I1_2 98 NEUTRON -35 MOD1 MOD2,, 0.0007 1E-13 500,,, 3
USRBDX I1_3 98 NEUTRON -36 MOD2 MOD3,, 0.0007 1E-13 500,,, 3
USRBDX I1_4 98 NEUTRON -37 MOD3 MOD4,, 0.0007 1E-13 500,,, 3
USRBDX I1_5 98 NEUTRON -38 MOD4 MOD5,, 0.0007 1E-13 500,,, 3
USRBDX I1_6 98 NEUTRON -39 MOD5 MOD6,, 0.0007 1E-13 500,,, 3
USRBDX I1_7 98 NEUTRON -40 MOD6 MOD7,, 0.0007 1E-13 500,,, 3
USRBDX I1_8 98 NEUTRON -41 MOD7 MOD8,, 0.0007 1E-13 500,,, 3
USRBDX I1_9 98 NEUTRON -42 MOD8 AIR,, 0.0007 1E-13 500,,, 3
USRBDX I2_1 108 NEUTRON -43 AIR MOD1,, 0.0007 1E-13 500,,, 3
USRBDX I2_2 108 NEUTRON -44 MOD1 MOD2,, 0.0007 1E-13 500,,, 3
USRBDX I2_3 108 NEUTRON -45 MOD2 MOD3,, 0.0007 1E-13 500,,, 3
USRBDX I2_4 108 NEUTRON -46 MOD3 MOD4,, 0.0007 1E-13 500,,, 3
USRBDX I2_5 108 NEUTRON -47 MOD4 MOD5,, 0.0007 1E-13 500,,, 3
USRBDX I2_6 108 NEUTRON -48 MOD5 MOD6,, 0.0007 1E-13 500,,, 3
USRBDX I2_7 108 NEUTRON -49 MOD6 MOD7,, 0.0007 1E-13 500,,, 3
USRBDX I2_8 108 NEUTRON -50 MOD7 MOD8,, 0.0007 1E-13 500,,, 3
USRBDX I2_9 108 NEUTRON -51 MOD8 AIR,, 0.0007 1E-13 500,,, 3
USRBDX I_n2 111 NEUTRON -52 LIF FLANGE,, 0.001 1E-13 100,,, 3
USRBDX I_n1 101 NEUTRON -52 LIF FLANGE,, 0.001 1E-13 100,,, 3
!SCORE , PROTON NEUTRON
LOW-NEUT , 260 42 0.02 0,, 4
LOW-PWXS ENDF-VIII0
!BIASING PRINT 3 100000,, LIF FLANGE
LAM-BIAS GDECAY 1 0.002 LiF PROTON
!BIASING PRINT 3 5 100000 MOD8
!AUTOIMBS CONFIG,, -1 0
!AUTOIMBS PRINT 0 3 1
!AUTOIMBS , tube1 1 mod
GEOBEGIN COMBNAME
SPH blkbody,, 0.0 0.0 100000.0
	@select=8
SPH air,, 0.0 0.0 10000.0
	@select=8
RCC pipeIn 0 0 -30 0 0 30.1 3.5
RCC pipeOut 0 0 -30 0 0 30.1 4
RCC lif 0 0 -0.9 0 0 1 1.9
RCC flange 0 0 -0.5 0 0 1.0 5
RPP tube -15.0 15.0 -15.0 15.0 -16 32.0
RPP tube1 -10.0 10.0 -10.0 10.0 -15 32.0
RPP tubeHole -5.0 5.0 -5.0 5.0 -16 0
XYP modEnd1 4
XYP modEnd2 8
XYP modEnd3 12
XYP modEnd4 16
XYP modEnd5 20
XYP modEnd6 24
XYP modEnd7 28
	@select=1
RPP mod -5 5 -5 5 0 32
END
* Black hole
REGION BLKBODY 5
	+blkbody -air
REGION AIR 5
	+air -tube -tubeHole -pipeOut 
REGION LIF 5
	+lif -flange
REGION FLANGE 5
	+flange -mod
REGION TUBE 5
	+tube -tube1 -tubeHole
	alpha=50
REGION TUBE1 5
	+tube1 -mod -tubeHole
	alpha=50
REGION TUBEHOLE 5
	+tubeHole -flange -pipeOut
	alpha=50
REGION PIPEOUT 5
	+pipeOut -pipeIn -flange 
	alpha=50
REGION PIPEIN 5
	+pipeIn -lif -flange
	alpha=50
REGION MOD1 5
	+mod +modEnd1
REGION MOD2 5
	+mod -modEnd1 +modEnd2
REGION MOD3 5
	+mod -modEnd2 +modEnd3
REGION MOD4 5
	+mod -modEnd3 +modEnd4
REGION MOD5 5
	+mod -modEnd4 +modEnd5
REGION MOD6 5
	+mod -modEnd5 +modEnd6
REGION MOD7 5
	+mod -modEnd6 +modEnd7
REGION MOD8 5
	+mod -modEnd7
END
GEOEND
MATERIAL FLUORINE 9,, 0.0015803
*Polytetrafluoroethylene teflon (C2_F4)n
MATERIAL TEFLON,,, 2.2
COMPOUND TEFLON -0.240183 CARBON -0.759817 FLUORINE
MATERIAL LITHIUM 3,, 0.534
*Lithium fluoride Li_F
MATERIAL LiF,,, 2.635
COMPOUND LiF -0.267585 LITHIUM -0.732415 FLUORINE
MATERIAL CADMIUM 48,, 8.65
MATERIAL TELLURIU 52,, 6.24
*Cadmium telluride Cd_Te
MATERIAL CdTe,,, 6.2
COMPOUND CdTe -0.468355 CADMIUM -0.531645 TELLURIU
MATERIAL CHROMIUM 24,, 7.18
*Stainless-Steel (typical)
*Stainless-Steel is produced with Cr content ranging from
*4 - 19 Atomic Percent, and with C content from 0 - 4 percent.
MATERIAL Stainles,,, 8.0
COMPOUND Stainles 18.0 CHROMIUM 74.0 IRON 8.0 NICKEL
ASSIGNMA , BLCKHOLE BLKBODY
ASSIGNMA , AIR AIR
ASSIGNMA , LEAD TUBE
ASSIGNMA , TEFLON TUBE1
ASSIGNMA , AIR TUBEHOLE
ASSIGNMA , Stainles PIPEOUT
ASSIGNMA , VACUUM PIPEIN
ASSIGNMA , ALUMINUM FLANGE
ASSIGNMA , LiF LIF
ASSIGNMA , TEFLON MOD1 MOD7 2
ASSIGNMA , ALUMINUM MOD2 MOD8 2
* Set the random number seed
RANDOMIZ ,, 377746
* Set the number of primary histories to be simulated in the run
START , 100000,,, 1
STOP
EndInput

Page: Input
Calculator:
