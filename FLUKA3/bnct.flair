XYP modp32 31
XYP modp33 32
RPP mod -5 5 -5 5 0 32
END
* Black hole
REGION BLKBODY 5
	+blkbody -air
REGION AIR 5
	+air -tube -tube1 -tubeHole -pipeOut -phantom -linecam 
REGION LIF 5
	+lif -flange
REGION FLANGE 5
	+flange -mod
REGION TUBE 5
	+tube -tubeHole -tubeHol1 
	alpha=50
REGION TUBE1 5
	+tube1 -tubeHole -mod
	alpha=50
REGION TUBEHOLE 5
	+tubeHole -flange -pipeOut -tubeHol1 
	alpha=50
REGION TUBEHOL1 5
	+tubeHol1 -pipeOut 
	alpha=50
REGION PIPEOUT 5
	+pipeOut -pipeIn -flange 
	alpha=50
REGION PIPEIN 5
	+pipeIn -lif -flange
	alpha=50
REGION LINECAM 5
	+linecam
	alpha=50
REGION BORON 5
	+boron
	alpha=50
REGION PHANTOM 5
	+phantom -boron
	alpha=50
REGION MOD2 5
	+mod +modp2
REGION MOD3 5
	+mod -modp2 +modp3
REGION MOD4 5
