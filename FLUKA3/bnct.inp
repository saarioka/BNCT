GEOBEGIN                                                              COMBNAME
    0    0          
SPH blkbody    0.0 0.0 0.0 100000.0
SPH air        0.0 0.0 0.0 10000.0
RCC pipeIn     0 0 -30 0 0 30.1 3.5
RCC pipeOut    0 0 -30 0 0 30.1 4
RCC lif        0 0 -0.9 0 0 1 1.9
RCC flange     0 0 -0.5 0 0 1.0 4
RPP tube       -15.0 15.0 -15.0 15.0 -20 0
RPP tube1      -10.0 10.0 -10.0 10.0 0 32.0
RPP tubeHole   -9.0 9.0 -9.0 9.0 -16 0
RPP tubeHol1   -9.0 9.0 -9.0 9.0 -20 -15
RPP phantom    -3 3 -3 3 35 41
RPP boron      -1 1 -1 1 37 39
RPP linecam    -10 10 9.9 10.1 37.8 38
XYP modp2      1
XYP modp3      2
XYP modp4      3
XYP modp5      4
XYP modp6      5
XYP modp7      6
XYP modp8      7
XYP modp9      8
XYP modp10     9
XYP modp11     10
XYP modp12     11
XYP modp13     12
XYP modp14     13
XYP modp15     14
XYP modp16     15
