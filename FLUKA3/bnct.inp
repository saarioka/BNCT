MOD12        5 +mod -modp11 +modp12
MOD13        5 +mod -modp12 +modp13
MOD14        5 +mod -modp13 +modp14
MOD15        5 +mod -modp14 +modp15
MOD16        5 +mod -modp15 +modp16
MOD17        5 +mod -modp16 +modp17
MOD18        5 +mod -modp17 +modp18
MOD19        5 +mod -modp18 +modp19
MOD20        5 +mod -modp19 +modp20
MOD21        5 +mod -modp20 +modp21
MOD22        5 +mod -modp21 +modp22
MOD23        5 +mod -modp22 +modp23
MOD24        5 +mod -modp23 +modp24
MOD25        5 +mod -modp24 +modp25
MOD26        5 +mod -modp25 +modp26
MOD27        5 +mod -modp26 +modp27
MOD28        5 +mod -modp27 +modp28
MOD29        5 +mod -modp28 +modp29
MOD30        5 +mod -modp29 +modp30
MOD31        5 +mod -modp30 +modp31
MOD32        5 +mod -modp31 +modp32
MOD33        5 +mod -modp32 +modp33
END
GEOEND
MATERIAL           9           0.0015803                              FLUORINE
*Polytetrafluoroethylene teflon (C2_F4)n
MATERIAL                             2.2                              TEFLON
COMPOUND   -0.240183    CARBON -0.759817  FLUORINE                    TEFLON
MATERIAL           3               0.534                              LITHIUM
*Lithium fluoride Li_F
MATERIAL                           2.635                              LiF
COMPOUND   -0.267585   LITHIUM -0.732415  FLUORINE                    LiF
MATERIAL          48                8.65                              CADMIUM
MATERIAL          52                6.24                              TELLURIU
*Cadmium telluride Cd_Te
MATERIAL                             6.2                              CdTe
COMPOUND   -0.468355   CADMIUM -0.531645  TELLURIU                    CdTe
MATERIAL          24                7.18                              CHROMIUM
*Stainless-Steel (typical)
*Stainless-Steel is produced with Cr content ranging from
*4 - 19 Atomic Percent, and with C content from 0 - 4 percent.
MATERIAL                             8.0                              Stainles
COMPOUND        18.0  CHROMIUM      74.0      IRON       8.0    NICKELStainles
MATERIAL           5                2.37                              BORON
*Boron oxide B2_O3
MATERIAL                           1.812                              B2O3
COMPOUND   -0.310551     BORON -0.689449    OXYGEN                    B2O3
*Boron acid
MATERIAL                           1.435                              BAcid
COMPOUND   -0.174842     BORON -0.776255    OXYGEN -0.048903  HYDROGENBAcid
ASSIGNMA    BLCKHOLE   BLKBODY
ASSIGNMA         AIR       AIR
ASSIGNMA        LEAD      TUBE
ASSIGNMA        LEAD     TUBE1
ASSIGNMA      TEFLON  TUBEHOLE
ASSIGNMA         AIR  TUBEHOL1
ASSIGNMA    Stainles   PIPEOUT
ASSIGNMA      VACUUM    PIPEIN
ASSIGNMA    Stainles    FLANGE
ASSIGNMA         LiF       LIF
ASSIGNMA        PMMA   PHANTOM
ASSIGNMA       BAcid     BORON
ASSIGNMA        CdTe   LINECAM
ASSIGNMA      TEFLON      MOD2     MOD32         2
ASSIGNMA    ALUMINUM      MOD3     MOD33         2
* Set the random number seed
RANDOMIZ                377746
* Set the number of primary histories to be simulated in the run
START      100000000                             1
STOP
