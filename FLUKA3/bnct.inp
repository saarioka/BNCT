XYP modp28     27
XYP modp29     28
XYP modp30     29
XYP modp31     30
XYP modp32     31
XYP modp33     32
RPP mod        -5 5 -5 5 0 32
END
* Black hole
BLKBODY      5 +blkbody -air
AIR          5 +air -tube -tube1 -tubeHole -pipeOut -phantom -linecam
LIF          5 +lif -flange
FLANGE       5 +flange -mod
!@alpha=50
TUBE         5 +tube -tubeHole -tubeHol1
!@alpha=50
TUBE1        5 +tube1 -tubeHole -mod
!@alpha=50
TUBEHOLE     5 +tubeHole -flange -pipeOut -tubeHol1
!@alpha=50
TUBEHOL1     5 +tubeHol1 -pipeOut
!@alpha=50
PIPEOUT      5 +pipeOut -pipeIn -flange
!@alpha=50
PIPEIN       5 +pipeIn -lif -flange
!@alpha=50
LINECAM      5 +linecam
!@alpha=50
BORON        5 +boron
!@alpha=50
PHANTOM      5 +phantom -boron
MOD2         5 +mod +modp2
MOD3         5 +mod -modp2 +modp3
MOD4         5 +mod -modp3 +modp4
MOD5         5 +mod -modp4 +modp5
MOD6         5 +mod -modp5 +modp6
MOD7         5 +mod -modp6 +modp7
MOD8         5 +mod -modp7 +modp8
MOD9         5 +mod -modp8 +modp9
