* Black hole
BLKBODY      5 +blkbody -air
AIR          5 +air -tube -tubeHole -pipeOut
LIF          5 +lif -flange
FLANGE       5 +flange -mod
!@alpha=50
TUBE         5 +tube -tube1 -tubeHole
!@alpha=50
TUBE1        5 +tube1 -mod -tubeHole
!@alpha=50
TUBEHOLE     5 +tubeHole -flange -pipeOut
!@alpha=50
PIPEOUT      5 +pipeOut -pipeIn -flange
!@alpha=50
