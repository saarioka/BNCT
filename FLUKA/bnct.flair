# flair project file
Version: 300
Mode: fluka
Title: LiF neutron source
md5: bc0a9462bbfb660ddd54b1d83998bff2
Input:
RADDECAY , 2 1,, 333333303,, 1
* Set the defaults for precision simulations
DEFAULTS PRECISIO
* Define the beam characteristics
BEAM NEUTRON -0.0006 0 -1.0 -1.0 -1.0 1.0
	@select=8
BEAMPOS , 0 0 -0.1 0 0
!PHYSICS COALESCE 1
PHYSICS EVAPORAT 3
!EMF
USRBIN Ndepth 10 NEUTRON -22 10 10 10 -10 -10 0 1 100 100
USRBIN Nwidth 10 NEUTRON -23 10 10 10 -10 -10 0 1000 1000 1
USRBIN NRZ 11 NEUTRON -24 10,, 10,,, 0 1000 1 1000
!USRBIN NielDep 11 NIEL-DEP -25 5 0 0.3 0 0 0 1000 1000 1000
!USRBIN ScorerNH 10 NEUTRON -26 50 50 20.3 0 0 20.2 100 100 1
!USRBIN ScorerNH2 11 NEUTRON -27 50,, 20.3 0,, 19.3 50 50 1
USRBDX I1_1 -2 NEUTRON -34 AIR MOD1,, 0.0007 1E-13 500,,, 3
USRBDX I1_2 -2 NEUTRON -35 MOD1 MOD2,, 0.0007 1E-13 500,,, 3
USRBDX I1_3 -2 NEUTRON -36 MOD2 MOD3,, 0.0007 1E-13 500,,, 3
USRBDX I1_4 -2 NEUTRON -37 MOD3 MOD4,, 0.0007 1E-13 500,,, 3
USRBDX I1_5 -2 NEUTRON -38 MOD4 MOD5,, 0.0007 1E-13 500,,, 3
USRBDX I1_6 -2 NEUTRON -39 MOD5 MOD6,, 0.0007 1E-13 500,,, 3
USRBDX I1_7 -2 NEUTRON -40 MOD6 MOD7,, 0.0007 1E-13 500,,, 3
USRBDX I1_8 -2 NEUTRON -41 MOD7 MOD8,, 0.0007 1E-13 500,,, 3
USRBDX I1_9 -2 NEUTRON -42 MOD8 AIR,, 0.0007 1E-13 500,,, 3
USRBDX I2_1 8 NEUTRON -43 AIR MOD1,, 0.0007 1E-13 500,,, 3
USRBDX I2_2 8 NEUTRON -44 MOD1 MOD2,, 0.0007 1E-13 500,,, 3
USRBDX I2_3 8 NEUTRON -45 MOD2 MOD3,, 0.0007 1E-13 500,,, 3
USRBDX I2_4 8 NEUTRON -46 MOD3 MOD4,, 0.0007 1E-13 500,,, 3
USRBDX I2_5 8 NEUTRON -47 MOD4 MOD5,, 0.0007 1E-13 500,,, 3
USRBDX I2_6 8 NEUTRON -48 MOD5 MOD6,, 0.0007 1E-13 500,,, 3
USRBDX I2_7 8 NEUTRON -49 MOD6 MOD7,, 0.0007 1E-13 500,,, 3
USRBDX I2_8 8 NEUTRON -50 MOD7 MOD8,, 0.0007 1E-13 500,,, 3
USRBDX I2_9 8 NEUTRON -51 MOD8 AIR,, 0.0007 1E-13 500,,, 3
SCORE , PROTON NEUTRON
!USRTRACK flnvlm,, NEUTRON -41 DET_AM 78.5398 100,, 0.001
!IONTRANS , -2
!IRRPROFI , 3600 3.1E+12
LOW-NEUT , 260 42 0.02 0,, 4
!PHYSICS DECAYS 3,,,, NEUTRON 1000
!PHYSICS PEATHRES 1
!PHYSICS EM-DISSO 4
!PHYSICS DPMTHRES
!EVENTYPE DPMJET,,, 1
!EVENTYPE DPMJET,,, 2
!PART-THR , -1E-14,, NEUTRON
!LOW-DOWN
GEOBEGIN COMBNAME
SPH blkbody,, 0.0 0.0 100000.0
	@select=8
*
SPH air,, 0.0 0.0 10000.0
	@select=8
!RCC tubeIn,,, -10,,, 10.25 5
!RCC tubeOut,,, -10,,, 10.25 6
!XYP LiFStart -0.3
!XYP LiFEnd 0
!XYP DumpEnd 0.25
XYP modEnd1 1
XYP modEnd2 2
XYP modEnd3 3
XYP modEnd4 4
XYP modEnd5 5
XYP modEnd6 6
XYP modEnd7 7
RPP mod -10 10 -10 10 0 8
!XYP scorerp1 20.3
!XYP scorerp2 20.4
!RCC scorer,,, 20,,, 1 50
!RPP scorer 0 100 0 100 20 21
!RPP BB -100 100 -100 100 21.1 22.1
!XYP modEnd2 111
	@select=8
!XYP modEnd4 111
	@select=8
!XYP modEnd7 111
	@select=8
!XYP modEnd8 111
	@select=8
!XYP modEnd11 111
	@select=8
!XYP modEnd12 111
	@select=8
!REGION TARGET 5
	+tubeIn -LiFStart +LiFEnd 
!XYP modEnd15 111
	@select=8
!XYP modEnd16 111
	@select=8
!XYP modEnd19 111
	@select=8
!XYP modEnd20 111
	@select=8
!XYP modEnd25 111
	@select=8
!XYP modEnd26 111
	@select=8
!XYP modEnd27 111
	@select=8
!XYP modEnd28 111
	@select=8
!XYP modEnd33 111
	@select=8
!XYP modEnd34 111
	@select=8
!XYP modEnd35 111
	@select=8
!XYP modEnd36 111
	@select=8
!XYP modEnd41 111
	@select=8
!XYP modEnd42 111
	@select=8
END
* Black hole
REGION BLKBODY 5
	+blkbody -air
* Black hole
REGION AIR 5
	+air -mod
REGION MOD1 5
	+mod +modEnd1
REGION MOD2 5
	+mod -modEnd1 +modEnd2
REGION MOD3 5
	+mod -modEnd2 +modEnd3
REGION MOD4 5
	+mod -modEnd3 +modEnd4
REGION MOD5 5
	+mod -modEnd4 +modEnd5
REGION MOD6 5
	+mod -modEnd5 +modEnd6
REGION MOD7 5
	+mod -modEnd6 +modEnd7
REGION MOD8 5
	+mod -modEnd7
END
GEOEND
ASSIGNMA , BLCKHOLE BLKBODY
ASSIGNMA , VACUUM AIR
ASSIGNMA , PMMA MOD1
ASSIGNMA , PMMA MOD2
ASSIGNMA , PMMA MOD3
ASSIGNMA , PMMA MOD4
ASSIGNMA , PMMA MOD5
ASSIGNMA , PMMA MOD6
ASSIGNMA , PMMA MOD7
ASSIGNMA , PMMA MOD8
* Set the random number seed
RANDOMIZ ,, 377746
* Set the number of primary histories to be simulated in the run
START , 100000,,, 1
STOP
EndInput

