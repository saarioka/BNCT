# flair project file
Version: 300
Mode: fluka
Title: LiF neutron source
md5: 83c3b9556e43c0165dcbe5621e707d9c
Input:
RADDECAY , 2 1,, 333333303,, 1
* Set the defaults for precision simulations
DEFAULTS PRECISIO
!#define ENERGY -0.0006
* Define the beam characteristics
!BEAM NEUTRON $ENERGY 0 -3000.0 -1.0 -1.0 1.0
	@select=8
* Define the beam characteristics
!BEAM NEUTRON -0.00035 '=dT2dp(0.0007,0.0007,Mn)' 13140.0 2.0 0 -1.0
	@select=8
* Define the beam characteristics
BEAM NEUTRON -0.0005 0 13140.0 2.0 0 -1.0
	@select=8
BEAMPOS , 0 0 -0.1 0 0
!PHYSICS COALESCE 1
PHYSICS EVAPORAT 3
!EMF
USRBIN Ndepth 10 NEUTRON -22 10 10 10 -10 -10 0 1 100 100
USRBIN Nwidth 10 NEUTRON -23 10 10 10 -10 -10 0 1000 1000 1
USRBIN NRZ 11 NEUTRON -24 10,, 10,,, 0 1000 1 1000
!USRBIN NielDep 11 NIEL-DEP -25 5 0 0.3 0 0 0 1000 1000 1000
!USRBIN ScorerNH 10 NEUTRON -26 50 50 20.3 0 0 20.2 100 100 1
!USRBIN ScorerNH2 11 NEUTRON -27 50,, 20.3 0,, 19.3 50 50 1
USRBDX I1_1 98 NEUTRON -34 VAC MOD1,, 0.0007 1E-13 500,,, 3
USRBDX I1_2 98 NEUTRON -35 MOD1 MOD2,, 0.0007 1E-13 500,,, 3
USRBDX I1_3 98 NEUTRON -36 MOD2 MOD3,, 0.0007 1E-13 500,,, 3
USRBDX I1_4 98 NEUTRON -37 MOD3 MOD4,, 0.0007 1E-13 500,,, 3
USRBDX I1_5 98 NEUTRON -38 MOD4 MOD5,, 0.0007 1E-13 500,,, 3
USRBDX I1_6 98 NEUTRON -39 MOD5 MOD6,, 0.0007 1E-13 500,,, 3
USRBDX I1_7 98 NEUTRON -40 MOD6 MOD7,, 0.0007 1E-13 500,,, 3
USRBDX I1_8 98 NEUTRON -41 MOD7 MOD8,, 0.0007 1E-13 500,,, 3
USRBDX I1_9 98 NEUTRON -42 MOD8 VAC,, 0.0007 1E-13 500,,, 3
USRBDX I2_1 108 NEUTRON -43 VAC MOD1,, 0.0007 1E-13 500,,, 3
USRBDX I2_2 108 NEUTRON -44 MOD1 MOD2,, 0.0007 1E-13 500,,, 3
USRBDX I2_3 108 NEUTRON -45 MOD2 MOD3,, 0.0007 1E-13 500,,, 3
USRBDX I2_4 108 NEUTRON -46 MOD3 MOD4,, 0.0007 1E-13 500,,, 3
USRBDX I2_5 108 NEUTRON -47 MOD4 MOD5,, 0.0007 1E-13 500,,, 3
USRBDX I2_6 108 NEUTRON -48 MOD5 MOD6,, 0.0007 1E-13 500,,, 3
USRBDX I2_7 108 NEUTRON -49 MOD6 MOD7,, 0.0007 1E-13 500,,, 3
USRBDX I2_8 108 NEUTRON -50 MOD7 MOD8,, 0.0007 1E-13 500,,, 3
USRBDX I2_9 108 NEUTRON -51 MOD8 VAC,, 0.0007 1E-13 500,,, 3
SCORE , PROTON NEUTRON
!USRTRACK flnvlm,, NEUTRON -41 DET_AM 78.5398 100,, 0.001
!IONTRANS , -2
!IRRPROFI , 3600 3.1E+12
LOW-NEUT , 260 42 0.02 0,, 4
!PHYSICS DECAYS 3,,,, NEUTRON 1000
!PHYSICS PEATHRES 1
!PHYSICS EM-DISSO 4
!PHYSICS DPMTHRES
!EVENTYPE DPMJET,,, 1
!EVENTYPE DPMJET,,, 2
!PART-THR , -1E-14,, NEUTRON
!LOW-DOWN
GEOBEGIN COMBNAME
SPH blkbody,, 0.0 0.0 100000.0
	@select=8
*
SPH air,, 0.0 0.0 10000.0
	@select=8
!RCC tubeIn,,, -10,,, 10.25 5
!RCC tubeOut,,, -10,,, 10.25 6
!XYP LiFStart -0.3
!XYP LiFEnd 0
!XYP DumpEnd 0.25
RPP tube -10 10 -10 10 0 32
!RPP ref1 -5 5 -5 5 -25 0
!RPP ref2 -5 5 -5 5 -20 -5
RPP czt -1 1 48 50 48 50
XYP modEnd1 4
XYP modEnd2 8
XYP modEnd3 12
XYP modEnd4 16
XYP modEnd5 20
XYP modEnd6 24
XYP modEnd7 28
RPP mod -5 5 -5 5 0 32
!XYP scorerp1 20.3
!XYP scorerp2 20.4
!RCC scorer,,, 20,,, 1 50
!RPP scorer 0 100 0 100 20 21
!RPP BB -100 100 -100 100 21.1 22.1
!XYP modEnd2 111
	@select=8
!XYP modEnd4 111
	@select=8
!XYP modEnd7 111
	@select=8
!XYP modEnd8 111
	@select=8
!XYP modEnd11 111
	@select=8
!XYP modEnd12 111
	@select=8
!REGION TARGET 5
	+tubeIn -LiFStart +LiFEnd 
!XYP modEnd15 111
	@select=8
!XYP modEnd16 111
	@select=8
!XYP modEnd19 111
	@select=8
!XYP modEnd20 111
	@select=8
!XYP modEnd25 111
	@select=8
!XYP modEnd26 111
	@select=8
!XYP modEnd27 111
	@select=8
!XYP modEnd28 111
	@select=8
!XYP modEnd33 111
	@select=8
!XYP modEnd34 111
	@select=8
!XYP modEnd35 111
	@select=8
!XYP modEnd36 111
	@select=8
!XYP modEnd41 111
	@select=8
!XYP modEnd42 111
	@select=8
END
* Black hole
REGION BLKBODY 5
	+blkbody -air
*
REGION VAC 5
	+air -tube -czt
* Tube
REGION TUBE 5
	+tube -mod
	@select=1
	alpha=50
*
REGION CZT 5
	+czt
	alpha=50
*
!REGION REF1 5
	+ref1
*
!REGION REF2 5
	+ref2
REGION MOD1 5
	+mod +modEnd1
REGION MOD2 5
	+mod -modEnd1 +modEnd2
REGION MOD3 5
	+mod -modEnd2 +modEnd3
REGION MOD4 5
	+mod -modEnd3 +modEnd4
REGION MOD5 5
	+mod -modEnd4 +modEnd5
REGION MOD6 5
	+mod -modEnd5 +modEnd6
REGION MOD7 5
	+mod -modEnd6 +modEnd7
REGION MOD8 5
	+mod -modEnd7
END
GEOEND
MATERIAL FLUORINE 9,, 0.0015803
*Polytetrafluoroethylene teflon (C2_F4)n
MATERIAL TEFLON,,, 2.2
COMPOUND TEFLON -0.240183 CARBON -0.759817 FLUORINE
MATERIAL LITHIUM 3,, 0.534
*Lithium fluoride Li_F
MATERIAL LiF,,, 2.635
COMPOUND LiF -0.267585 LITHIUM -0.732415 FLUORINE
MATERIAL CADMIUM 48,, 8.65
MATERIAL TELLURIU 52,, 6.24
*Cadmium telluride Cd_Te
MATERIAL CdTe,,, 6.2
COMPOUND CdTe -0.468355 CADMIUM -0.531645 TELLURIU
ASSIGNMA , BLCKHOLE BLKBODY
ASSIGNMA , VACUUM VAC
ASSIGNMA , LEAD TUBE
ASSIGNMA , CdTe CZT
!ASSIGNMA , TEFLON REF1
!ASSIGNMA , LiF REF2
ASSIGNMA , TEFLON MOD1
ASSIGNMA , ALUMINUM MOD2
ASSIGNMA , TEFLON MOD3
ASSIGNMA , ALUMINUM MOD4
ASSIGNMA , TEFLON MOD5
ASSIGNMA , ALUMINUM MOD6
ASSIGNMA , TEFLON MOD7
ASSIGNMA , ALUMINUM MOD8
* Set the random number seed
RANDOMIZ ,, 377746
* Set the number of primary histories to be simulated in the run
START , 1000000,,, 1
STOP
EndInput

